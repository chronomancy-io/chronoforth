# Auto line endings
* text=auto

# Force LF for source files
*.md text eol=lf
*.txt text eol=lf
*.asm text eol=lf
*.fs text eol=lf
*.py text eol=lf
*.adoc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Makefile text eol=lf

# Binary files
*.d64 binary
*.d71 binary
*.d81 binary
*.prg binary
*.crt binary
*.bin binary
*.pet binary
*.pdf binary
*.jpg binary
*.png binary
